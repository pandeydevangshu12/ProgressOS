# ==============================================================================
# ProgressOS Environment Configuration Template
# Safe placeholder values only — DO NOT put real secrets in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND VARIABLES
# (Accessible in client-side code; safe to bundle or expose in browser)
# ------------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key"
FRONTEND_URL="http://localhost:5000"

# ------------------------------------------------------------------------------
# 2. BACKEND SECRETS
# (Never expose to client-side code; set via Wrangler Secret or platform env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV="development"
CLERK_SECRET_KEY="sk_test_placeholder_secret"
GEMINI_API_KEY="AIzaSy_placeholder_key"
VIT_ENCRYPTION_KEY="replace-with-a-random-32-byte-hex-string-for-aes-256"
VIT_SYNC_INTERVAL_HOURS=6

# Cloudinary persistent photo storage credentials
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ------------------------------------------------------------------------------
# 3. DATABASE SECRETS
# (PostgreSQL connection string; pooled via Hyperdrive in production)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/progressos?sslmode=require"

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE BINDINGS (Configured in wrangler.jsonc / Cloudflare Dashboard)
# ------------------------------------------------------------------------------
# - ASSETS: Bound to ./dist/client directory (static frontend delivery)
# - HYPERDRIVE: Cloudflare Hyperdrive configuration ID for PostgreSQL connection
