{
  "name": "progressos",
  "version": "1.0.0",
  "description": "ProgressOS Full Stack",
  "main": "backend/dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch backend/src/index.ts",
    "build:client": "node scripts/build-client.js",
    "build:server": "npx tsc -p backend/tsconfig.json",
    "build:local": "npm run build:server",
    "build": "npm run build:client && npm run build:server",
    "start": "node backend/dist/index.js",
    "test": "tsx --test tests/**/*.test.ts",
    "cf:dev": "npx wrangler dev",
    "cf:deploy": "npm run build:client && npx wrangler deploy",
    "vercel-build": "npm run prisma:generate && npm run build:client",
    "prisma:generate": "npx prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=backend/prisma/schema.prisma",
    "prisma:deploy": "npx prisma migrate deploy --schema=backend/prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=backend/prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=backend/prisma/schema.prisma",
    "seed:demo": "npx tsx backend/seed-demo.ts",
    "postinstall": "npm run prisma:generate"
  },
  "dependencies": {
    "@clerk/express": "^2.1.26",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@vercel/node": "^3.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
