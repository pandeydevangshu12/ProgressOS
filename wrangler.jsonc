{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "progressos",
  "main": "./backend/src/worker.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // ─── Static Asset Serving ──────────────────────────────────────────────────
  // Bound strictly to dist/client — NEVER the repository root.
  // Contains only public HTML, CSS, JS, PWA assets, and _redirects rules.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // ─── Cloudflare Hyperdrive ─────────────────────────────────────────────────
  // Accelerated TCP connection pool for PostgreSQL database.
  // Replace <HYPERDRIVE_CONFIG_ID> with your Hyperdrive configuration ID from:
  // `npx wrangler hyperdrive create progressos-db --connection-string="<YOUR_DATABASE_URL>"`
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f727fe701d684548a4dc9ea91dde781f"
    }
  ],
  // ─── Public Environment Variables ─────────────────────────────────────────
  "vars": {
    "NODE_ENV": "production",
    "PORT": "3000"
  }
}